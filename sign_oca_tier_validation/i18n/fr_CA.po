#. module: sign_oca_tier_validation
#. odoo-python
#: code:addons/sign_oca_tier_validation/models/sign_oca_request.py:0
msgid "This tier asks for a comment with the signature."
msgstr "Ce palier exige un commentaire avec la signature."

#. module: sign_oca_tier_validation
#. odoo-python
#: code:addons/sign_oca_tier_validation/models/sign_oca_request.py:0
msgid ""
"This tier asks for a comment, but the document has no comment field for it."
msgstr ""
"Ce palier exige un commentaire, mais le document n'a pas de champ de "
"commentaire pour lui."

#. module: sign_oca_tier_validation
#. odoo-python
#: code:addons/sign_oca_tier_validation/models/sign_oca_request.py:0
msgid "This tier cannot be signed yet: an earlier tier has to sign first."
msgstr ""
"Ce palier ne peut pas encore être signé : un palier précédent doit signer "
"d'abord."

#. module: sign_oca_tier_validation
#. odoo-python
#: code:addons/sign_oca_tier_validation/models/sign_oca_request.py:0
msgid "This tier is already decided."
msgstr "Ce palier est déjà décidé."

#. module: sign_oca_tier_validation
#. odoo-python
#: code:addons/sign_oca_tier_validation/models/sign_oca_request.py:0
msgid ""
"This tier is approved along with an earlier tier of the same reviewer, "
"without a signature of its own."
msgstr ""
"Ce palier est approuvé avec un palier précédent du même approbateur, sans "
"signature propre."

