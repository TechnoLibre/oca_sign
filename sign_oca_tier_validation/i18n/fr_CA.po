msgstr "La validation de ce document est déjà décidée."

#. module: sign_oca_tier_validation
#. odoo-python
#: code:addons/sign_oca_tier_validation/models/sign_oca_request.py:0
msgid ""
"This document can only be signed by a reviewer of this tier, logged in."
msgstr ""
"Ce document ne peut être signé que par un réviseur de ce palier, connecté."

#. module: sign_oca_tier_validation
#. odoo-python
#: code:addons/sign_oca_tier_validation/models/sign_oca_request.py:0
