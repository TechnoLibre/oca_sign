#: model:ir.model.fields,help:sign_oca_tier_validation.field_sign_oca_request_signer__tier_notified
msgid "The reviewers of this tier got the email inviting them to sign."
msgstr ""
"Les réviseurs de ce palier ont reçu le courriel les invitant à signer."

#. module: sign_oca_tier_validation
#. odoo-python
#: code:addons/sign_oca_tier_validation/models/sign_oca_request.py:0
msgid "The tier %(tier)s could not be decided."
msgstr "Le palier %(tier)s n'a pas pu être décidé."

#. module: sign_oca_tier_validation
#. odoo-python
#: code:addons/sign_oca_tier_validation/models/tier_validation.py:0
msgid "The tier %(tier)s of %(record)s has no reviewer."
msgstr "Le palier %(tier)s de %(record)s n'a aucun réviseur."

#. module: sign_oca_tier_validation
#. odoo-python
#: code:addons/sign_oca_tier_validation/models/sign_oca_request.py:0
